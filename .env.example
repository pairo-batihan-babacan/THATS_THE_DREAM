# Copy to .env and fill in. Never commit the real .env — it is gitignored.

DEBUG=False
# openssl rand -hex 32
SECRET_KEY=replace-me

# ── Postgres (docker-compose.prod.yml brings this up) ──────────────────────
# POSTGRES_PASSWORD has no default on purpose: compose refuses to start without it.
POSTGRES_DB=pdfworks
POSTGRES_USER=pdfworks
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://pdfworks:replace-me@postgres:5432/pdfworks

# ── Redis ─────────────────────────────────────────────────────────────────
# Service name from the compose file, not localhost: the workers are in
# separate containers.
REDIS_URL=redis://redis:6379/0

# ── Files ─────────────────────────────────────────────────────────────────
# Must match the shared fileconvert_tmp volume mount, or a worker will write
# an output file that api cannot find on download.
UPLOAD_DIR=/tmp/fileconvert/uploads
OUTPUT_DIR=/tmp/fileconvert/outputs
MAX_FILE_SIZE_MB=20
MAX_FILE_SIZE_MB_PRO=50
FILE_TTL_MINUTES=30
FREE_CONVERSIONS_PER_DAY=3

# ── Worker layout ─────────────────────────────────────────────────────────
# Only read by start.sh (single-container deploys). docker-compose.prod.yml
# sets concurrency per service instead.
DEPLOY_PROFILE=vps
CELERY_DEFAULT_CONCURRENCY=3
CELERY_HEAVY_CONCURRENCY=1

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. app/main.py splits on commas — not a JSON array.
ALLOWED_ORIGINS=https://pdfworks.io,https://www.pdfworks.io

# ── Optional integrations: the app starts fine with these blank ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pdfworks.io/api/auth/google/callback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
GROQ_API_KEY=
